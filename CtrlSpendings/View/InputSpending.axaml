<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Width="500" Height="200"
        MinWidth="400" MinHeight="180"
        x:Class="CtrlSpendings.View.InputSpending"
        Title="Entrada de Gastos">

  <DockPanel>
    <StackPanel
            DockPanel.Dock="Bottom"
            FlowDirection="RightToLeft"
            Orientation="Horizontal" Margin="10">
      <Button Name="btOk" Margin="10">Ok</Button>
      <Button Name="btCancel" Margin="10">Cancel</Button>
    </StackPanel>

    <StackPanel>
        <DockPanel Margin="10">
          <Label DockPanel.Dock="Left">Concepto</Label>
          <TextBox Name="edConcept" />
        </DockPanel>
    
        <DockPanel Margin="10">
          <Label DockPanel.Dock="Left">Importe</Label>
          <NumericUpDown
              Name="edAmount"
              Value="0.00"
              Minimum="0.00"
              Increment="0.01"
              FormatString="0.00" />
        </DockPanel>
    </StackPanel>

  </DockPanel>
</Window>

